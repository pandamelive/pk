# GitHub 仓库地址（组织级用 https://github.com/你的组织名）
REPO_URL=https://github.com/pandamelive/pk

# Runner Token：在仓库 Settings → Actions → Runners → New self-hosted runner 里获取
# 或者用 PAT 调用 API 生成：
# curl -s -X POST -H "Authorization: token 你的PAT" https://api.github.com/repos/pandamelive/pk/actions/runners/registration-token | jq -r .token
RUNNER_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Runner 名称（可选，默认带 hostname）
RUNNER_NAME=docker-rust-runner

# Runner 标签（workflow 里用 runs-on: [self-hosted, docker, rust] 调度）
RUNNER_LABELS=docker,rust,self-hosted,linux,x64
